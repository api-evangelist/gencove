            "url": "https://api.gencove.com/api/v2/uploads/:upload_id",
            "params": [
              {
                "name": "upload_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
