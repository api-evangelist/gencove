{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gencove Back array upload API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "upload",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "upload_credentials_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gencove.com/api/v2/upload-credentials/",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "uploads_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gencove.com/api/v2/uploads/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search uploads by id"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter uploads by upload statuses"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve list of user uploads."
        },
        {
          "info": {
            "name": "uploads_delete_unassigned_create",
