            "name": "jwt_logout_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gencove.com/api/v2/jwt-logout/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
