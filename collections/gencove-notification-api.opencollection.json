{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gencove Back array notification API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "notification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "notifications_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gencove.com/api/v2/notifications/:notification_id",
            "params": [
              {
                "name": "notification_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List all available subscriptions for given project or create a new\nsubscription."
        }
      ]
    }
  ],
  "bundled": true
}